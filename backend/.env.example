APP_NAME=PDF Summarization Backend
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Origine(s) du frontend, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# postgresql://<user>:<password>@<host>:<port>/<database> — obligatoire, le backend ne démarre pas sans elle
DATABASE_URL=

BACKEND_ENGINE=ollama
OLLAMA_HOST=http://localhost:11434
SUMMARY_MODEL=qwen2.5:3b
ENABLE_LLM_JUDGE=false
LLM_JUDGE_MODEL=qwen2.5vl:7b
LLM_JUDGE_SAMPLE_MODE=representative
LLM_JUDGE_MAX_PAGES=3
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=2000
OLLAMA_NUM_CTX=8192
OLLAMA_QUALITY_NUM_CTX=8192

UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
