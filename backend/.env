APP_NAME=PDF Summarization Backend
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Use the real Ollama engine for full pipeline testing
BACKEND_ENGINE=ollama
ENABLE_LLM_JUDGE=false
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=1200
OLLAMA_NUM_CTX=4096
OLLAMA_QUALITY_NUM_CTX=8192

UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/team07
